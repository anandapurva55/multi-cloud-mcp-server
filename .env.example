# This file is generated by `python setup_wizard.py` — this is just a reference
# of the shape it writes. Do not hand-edit .env unless you know what you're doing;
# prefer re-running the wizard.
#
# This file is read from next to server.py (not the current directory).
# Set MULTICLOUD_MCP_ENV_FILE=/path/to/file to use a different one.

# ---- GCP ----
GCP_ENVIRONMENTS=dev,prod
GCP_DEFAULT_ENVIRONMENT=dev

GCP_ENV_DEV_PROJECT_ID=my-gcp-project-dev
GCP_ENV_DEV_REGION=us-central1
GCP_ENV_DEV_AUTH_MODE=adc
# Max bytes one BigQuery query may scan (refused above this). Default: 10000000000 (10 GB)
# GCP_ENV_DEV_MAX_BYTES_BILLED=10000000000

GCP_ENV_PROD_PROJECT_ID=my-gcp-project-prod
GCP_ENV_PROD_REGION=us-central1
GCP_ENV_PROD_AUTH_MODE=key_file
GCP_ENV_PROD_CREDENTIALS_PATH=/path/to/service-account.json

# ---- AWS ----
AWS_ENVIRONMENTS=staging,prod
AWS_DEFAULT_ENVIRONMENT=staging

AWS_ENV_STAGING_REGION=us-east-1
AWS_ENV_STAGING_AUTH_MODE=profile
AWS_ENV_STAGING_PROFILE=my-sso-profile

AWS_ENV_PROD_REGION=us-west-2
AWS_ENV_PROD_AUTH_MODE=keys
AWS_ENV_PROD_ACCESS_KEY_ID=AKIA...
AWS_ENV_PROD_SECRET_ACCESS_KEY=...
AWS_ENV_PROD_SESSION_TOKEN=
AWS_ENV_PROD_ATHENA_OUTPUT_LOCATION=s3://my-athena-results-bucket/prefix/
# Athena workgroup with a per-query data-scanned cutoff (recommended for cost control)
# AWS_ENV_PROD_ATHENA_WORKGROUP=mcp-readonly
